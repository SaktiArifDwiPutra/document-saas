# Backend environment template (placeholders only - never commit real secrets)

APP_NAME=Document SaaS API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# PostgreSQL connection string (asyncpg for runtime and Alembic migrations)
DATABASE_URL=postgresql+asyncpg://document_saas:replace-with-local-dev-password@localhost:5432/document_saas_dev

# Internal service-to-service HMAC authentication
INTERNAL_HMAC_SECRET=replace-with-local-dev-hmac-secret-minimum-32-chars
INTERNAL_HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# Configurable beta complimentary credits (initial amount TBD by Product Owner)
# BETA_COMPLIMENTARY_CREDITS=

# Comma-separated allowed CORS origins for static frontend
CORS_ORIGINS=["http://localhost:3000"]
