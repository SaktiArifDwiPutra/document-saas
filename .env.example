# Root environment template for local development (placeholders only - never commit real secrets)

# PostgreSQL (Docker Compose)
POSTGRES_USER=document_saas
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_DB=document_saas_dev
POSTGRES_PORT=5432

# Backend Database URL
DATABASE_URL=postgresql+asyncpg://document_saas:replace-with-local-dev-password@localhost:5432/document_saas_dev

# n8n (Docker Compose - local development only; production requires licensing approval)
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-random-local-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Jakarta

# Internal Service-to-Service HMAC Auth (Backend <-> n8n / Worker)
INTERNAL_HMAC_SECRET=replace-with-local-dev-hmac-secret-minimum-32-chars
INTERNAL_HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# Beta Complimentary Credits (Configurable; initial production/beta amount remains TBD by PO)
# BETA_COMPLIMENTARY_CREDITS=

# Frontend Public API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
