# Python Worker environment template (placeholders only - never commit real secrets)
# NOTE: Worker must NEVER receive or use DATABASE_URL or direct PostgreSQL credentials.

APP_NAME=Document SaaS Worker
ENVIRONMENT=local

# FastAPI internal callback endpoint (worker reports outcomes via signed HTTP callback only)
BACKEND_INTERNAL_BASE_URL=http://localhost:8000
WORKER_CALLBACK_PATH=/api/v1/internal/workers/callback

# Shared HMAC secret matching backend INTERNAL_HMAC_SECRET
INTERNAL_HMAC_SECRET=replace-with-local-dev-hmac-secret-minimum-32-chars

# Upload & archive processing safety bounds
MAX_FILE_SIZE_BYTES=10485760
MAX_ARCHIVE_EXPANSION_RATIO=10
MAX_ZIP_ENTRIES=1000
